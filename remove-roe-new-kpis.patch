-                    sprintf(paste0("%.", k$digits, "f"), abs(k$chg)), fmt(k$prev))
+  has_prev  <- !is.na(k$prev)
+  moved_bad <- has_prev && ((k$good == "up" && k$chg < 0) || (k$good == "down" && k$chg > 0))
+  change <- if (has_prev) {
